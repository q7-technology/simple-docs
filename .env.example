# Copy to .env and fill in. Nothing here is committed.

# Postgres (used by the db and api containers)
POSTGRES_DB=sdocs
POSTGRES_USER=sdocs
POSTGRES_PASSWORD=change-me
# Host port the database is published on (127.0.0.1 only). 5436 sits beside
# Simple WMS's 5433, Simple TMS's 5434 and Simple LMS's 5435.
# For local development and the tests, set POSTGRES_PASSWORD=sdocs-dev: the
# tests and the API's defaults expect it on this port unless TEST_DATABASE_URL
# or DOCS_DATABASE_URL says otherwise. Use a real password anywhere else.
POSTGRES_PORT=5436
